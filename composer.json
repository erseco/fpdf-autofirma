{
  "name": "erseco/fpdf-autofirma",
  "description": "FPDF extension providing AutoFirma integration, visible PAdES signature areas and signing parameters for browser-based electronic signatures",
  "keywords": [
    "autofirma",
    "electronic-signature",
    "fpdf",
    "pades",
    "pdf",
    "spain"
  ],
  "homepage": "https://github.com/erseco/fpdf-autofirma",
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "Ernesto Serrano",
      "homepage": "https://github.com/erseco"
    }
  ],
  "support": {
    "issues": "https://github.com/erseco/fpdf-autofirma/issues",
    "source": "https://github.com/erseco/fpdf-autofirma"
  },
  "require": {
    "php": ">=7.4",
    "setasign/fpdf": "^1.8"
  },
  "require-dev": {
    "phpstan/phpstan": "^1.12 || ^2.1",
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.13 || ^4.0"
  },
  "autoload": {
    "psr-4": {
      "Erseco\\FpdfAutoFirma\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Erseco\\FpdfAutoFirma\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "analyse": "phpstan analyse --configuration=phpstan.neon.dist --no-progress",
    "check": [
      "@lint",
      "@analyse",
      "@test"
    ],
    "coverage": [
      "phpunit --configuration=phpunit.xml.dist --coverage-clover=coverage.xml",
      "php scripts/check-coverage.php coverage.xml 90"
    ],
    "fix": "phpcbf --standard=.phpcs.xml.dist",
    "lint": "phpcs --standard=.phpcs.xml.dist",
    "test": "phpunit --configuration=phpunit.xml.dist"
  },
  "config": {
    "sort-packages": true
  },
  "archive": {
    "exclude": [
      "/.agents",
      "/.claude",
      "/.github",
      "/docs",
      "/scripts",
      "/tests",
      "/.editorconfig",
      "/.gitattributes",
      "/.gitignore",
      "/.phpcs.xml.dist",
      "/AGENTS.md",
      "/CONTRIBUTING.md",
      "/Makefile",
      "/codecov.yml",
      "/phpstan.neon.dist",
      "/phpunit.xml.dist"
    ]
  }
}
